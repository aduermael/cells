#!/bin/bash
# Git pre-commit hook for code quality checks
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit
# Or: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Get staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cc|h|cpp|hpp)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "Checking staged C++ files..."

# Check if clang-format is available
if command -v clang-format &> /dev/null; then
    FAILED=0
    for file in $STAGED_FILES; do
        if ! clang-format --dry-run --Werror "$file" 2>/dev/null; then
            echo -e "${RED}Format error:${NC} $file"
            FAILED=1
        fi
    done

    if [ $FAILED -ne 0 ]; then
        echo ""
        echo -e "${RED}Formatting issues detected!${NC}"
        echo "Run './scripts/format.sh' to fix them."
        exit 1
    fi

    echo -e "${GREEN}Format check passed${NC}"
else
    echo "clang-format not found, skipping format check"
fi
