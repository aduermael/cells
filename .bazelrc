# Cells Bazel Configuration

# Common settings
build --enable_platform_specific_config

# macOS-specific settings
build:macos --cxxopt=-std=c++17

# Linux-specific settings
build:linux --cxxopt=-std=c++17

# Windows-specific settings (MSVC)
build:windows --cxxopt=/std:c++17
# Bazel 9 defaults to manifest-only runfiles on Windows; unit tests that open
# data paths like testdata/*.csv need a real runfiles tree under the binary.
build:windows --enable_runfiles

# WebAssembly (Emscripten) build configuration
build:wasm --cxxopt=-fexceptions
build:wasm --linkopt=-fexceptions
build:wasm --linkopt=-sNO_DISABLE_EXCEPTION_CATCHING

# WebAssembly debug build (includes DWARF for Chrome DevTools debugging)
# See: https://developer.chrome.com/docs/devtools/wasm
build:wasm-debug --cxxopt=-fexceptions
build:wasm-debug --linkopt=-fexceptions
build:wasm-debug --linkopt=-sNO_DISABLE_EXCEPTION_CATCHING
build:wasm-debug --copt=-g
build:wasm-debug --cxxopt=-g
build:wasm-debug --linkopt=-gsource-map
build:wasm-debug --copt=-O0
build:wasm-debug --cxxopt=-O0
build:wasm-debug --linkopt=-O0
build:wasm-debug --strip=never

# Headless engine: CLI / converter only (do not build the WASM UI app).
# Use: bazel run :cli-headless
build:headless --define=CELLS_HEADLESS=1

# Production trim: skip the operation ledger and connectivity stack.
# Model does not construct an OpLog; CLI does not link CRDT sync, WebRTC, or
# the signaling client. Local file-backed sessions still work.
# Use: bazel run :cli-no-collab
# Combine with headless: bazel build --config=headless --config=no-collab //apps/cli:cells-no-collab
build:no-collab --define=CELLS_NO_COLLAB=1
