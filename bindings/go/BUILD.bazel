load("@rules_go//go:def.bzl", "go_binary")

# Excelize bridge library for XLSX reading/writing
# This builds as a C-archive (static library) that can be linked into C++ code
go_binary(
    name = "excelize_bridge",
    srcs = ["excelize_bridge.go"],
    cgo = True,
    linkmode = "c-archive",
    visibility = ["//visibility:public"],
    deps = ["@com_github_xuri_excelize_v2//:excelize"],
)
