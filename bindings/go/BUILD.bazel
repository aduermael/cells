load("@rules_go//go:def.bzl", "go_binary")

# Excelize bridge library for XLSX reading/writing
# This builds as a C-archive (static library) that can be linked into C++ code
go_binary(
    name = "excelize_bridge_go",
    srcs = ["excelize_bridge.go"],
    cgo = True,
    linkmode = "c-archive",
    visibility = ["//visibility:private"],
    deps = ["@com_github_xuri_excelize_v2//:excelize"],
)

# C++ wrapper for the Go library
# This exposes the header and links the static library for C++ targets
cc_library(
    name = "excelize_bridge",
    srcs = [":excelize_bridge_go"],
    hdrs = ["excelize_types.h"],
    includes = ["."],
    linkopts = select({
        "@platforms//os:macos": [
            "-framework", "CoreFoundation",
            "-framework", "Security",
            "-lresolv",
        ],
        "@platforms//os:linux": [
            "-lpthread",
            "-lresolv",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
