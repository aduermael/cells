module(
    name = "cells",
    version = "0.0.1",
)

# Platforms for OS-specific configurations
bazel_dep(name = "platforms", version = "1.0.0")

# Apple support (CC toolchain for objc_library)
# Must appear before rules_cc so Apple toolchains are selected
bazel_dep(name = "apple_support", version = "2.8.0")

# C++ / Objective-C / shell rules (no longer built into Bazel 9)
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Emscripten SDK for WebAssembly builds (6.x required for Bazel 9)
bazel_dep(name = "emsdk", version = "6.0.3")

# OpenSSL for libdatachannel crypto (BCR cc_library; pure-Bazel libdc deps)
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")

# libcurl for HTTP requests on Linux/native platforms
bazel_dep(name = "curl", version = "8.11.0.bcr.4")

# Google Test
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# Skylib (build_test and utilities)
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Native XLSX parsing - XML parser
bazel_dep(name = "pugixml", version = "1.14")

# Apple platform rules (for Objective-C++ support on macOS/iOS)
bazel_dep(name = "rules_apple", version = "4.5.3")

# rules_apple pulls rules_swift; pin a Bazel 9-compatible release:
# - 2.9.0+ treats missing swiftc.exe as optional (Windows CI of pure C++ targets)
# - 3.x loads CcInfo from rules_cc (native CcInfo was removed in Bazel 9)
single_version_override(
    module_name = "rules_swift",
    version = "3.6.1",
)

# Compile Commands Extractor (helly25 fork — upstream is unmaintained; Bazel 9
# removed native py_binary, which breaks the hedronvision pin).
# https://github.com/helly25/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "1f9360db1834d115c48279d38a97f30d64d3fd4a",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

# rules_perl - needed to define system Perl toolchain (transitive dep of openssl)
bazel_dep(name = "rules_perl", version = "1.1.0")

# System Perl toolchain for Alpine/musl builds
# The OpenSSL BCR package depends on rules_perl, which downloads glibc-linked
# Perl binaries that don't work on musl. This registers a toolchain that uses
# system Perl (/usr/bin/perl) instead, with higher priority than the default.
system_perl = use_repo_rule("//toolchains/perl:system_perl.bzl", "system_perl")

system_perl(name = "system_perl")

register_toolchains("//toolchains/perl:system_perl_toolchain")

# WebRTC XCFramework from stasel/WebRTC for Apple platforms
# https://github.com/stasel/WebRTC - BSD 3-Clause License
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "webrtc_xcframework",
    build_file = "//third_party/webrtc:BUILD.webrtc",
    sha256 = "e3b9bc1aed7a6f3f747a62567680ac7837bdbb74d1fae8f0f543131bc1bf8a5f",
    url = "https://github.com/stasel/WebRTC/releases/download/141.0.0/WebRTC-M141.xcframework.zip",
)

# libdatachannel - C++ WebRTC DataChannel implementation for native platforms
# https://github.com/paullouisageneau/libdatachannel - MPL 2.0 License
# Using git_repository to get submodules (libjuice, usrsctp, plog)
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "libdatachannel",
    build_file = "//third_party/libdatachannel:BUILD.libdatachannel",
    recursive_init_submodules = True,
    remote = "https://github.com/paullouisageneau/libdatachannel.git",
    tag = "v0.24.0",
)

# Luau - Fast, safe, gradually typed scripting language from Roblox
# https://github.com/luau-lang/luau - MIT License
git_repository(
    name = "luau",
    build_file = "//third_party/luau:BUILD.luau",
    remote = "https://github.com/luau-lang/luau.git",
    tag = "0.703",
)
