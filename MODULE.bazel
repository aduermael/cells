module(
    name = "cells",
    version = "0.0.1",
)

# Google Test
bazel_dep(name = "googletest", version = "1.14.0")

# Go rules for Excelize integration
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.40.0")

# Rules for building CMake/make projects
bazel_dep(name = "rules_foreign_cc", version = "0.12.0")

# Hedron's Compile Commands Extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "1e08f8e0507b6b6b1f4416a9a22cf5c28beaba93",
)

# OpenXLSX for Excel file support
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "openxlsx",
    urls = ["https://github.com/troldal/OpenXLSX/archive/5723411d47643ce3b5b9994064c26ca8cd841f13.tar.gz"],
    strip_prefix = "OpenXLSX-5723411d47643ce3b5b9994064c26ca8cd841f13",
    integrity = "sha256-hr23qllKCyvqMcrp5GA4MoRL4gldfigenX50ADvBa5g=",
    build_file = "//third_party:openxlsx.BUILD",
)

# Go SDK configuration
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.4")

# Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//bindings/go:go.mod")
use_repo(
    go_deps,
    "com_github_xuri_excelize_v2",
)
