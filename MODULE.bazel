module(
    name = "cells",
    version = "0.0.1",
)

# Platforms for OS-specific configurations
bazel_dep(name = "platforms", version = "0.0.11")

# Apple support (CC toolchain for objc_library)
# Must appear before rules_cc if present
bazel_dep(name = "apple_support", version = "2.0.0")

# Emscripten SDK for WebAssembly builds
bazel_dep(name = "emsdk", version = "4.0.17")

# Google Test
bazel_dep(name = "googletest", version = "1.14.0.bcr.1")

# Native XLSX parsing - XML parser
bazel_dep(name = "pugixml", version = "1.14")

# Apple platform rules (for Objective-C++ support on macOS/iOS)
bazel_dep(name = "rules_apple", version = "4.3.3")

# Hedron's Compile Commands Extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "1e08f8e0507b6b6b1f4416a9a22cf5c28beaba93",
)

# WebRTC XCFramework from stasel/WebRTC for Apple platforms
# https://github.com/stasel/WebRTC - BSD 3-Clause License
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "webrtc_xcframework",
    url = "https://github.com/stasel/WebRTC/releases/download/141.0.0/WebRTC-M141.xcframework.zip",
    sha256 = "e3b9bc1aed7a6f3f747a62567680ac7837bdbb74d1fae8f0f543131bc1bf8a5f",
    build_file = "//third_party/webrtc:BUILD.webrtc",
)
