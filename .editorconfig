# EditorConfig - https://editorconfig.org
# Ensures consistent coding styles across different editors

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C/C++ files
[*.{c,cc,cpp,cxx,h,hpp,hxx}]
indent_size = 4

# Bazel files
[{BUILD,*.bazel,*.bzl,WORKSPACE}]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4

# Makefile (requires tabs)
[Makefile]
indent_style = tab
